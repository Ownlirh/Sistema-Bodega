<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ventas" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="746" leftMargin="48" rightMargin="48" topMargin="32" bottomMargin="32" whenNoDataType="AllSectionsNoDetail">
  <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10" forecolor="#243447" />
  <parameter name="PERIODO" class="java.lang.String" />
