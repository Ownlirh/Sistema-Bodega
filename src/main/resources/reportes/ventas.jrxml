      <staticText>
        <reportElement x="7" y="65" width="732" height="17" forecolor="#53677B" />
        <textElement textAlignment="Left" verticalAlignment="Middle">
          <font size="8" isBold="false" />
        </textElement>
        <text>Las ventas anuladas están excluidas. Este total no representa utilidad.</text>
